# Token do bot do Discord (obtenha em https://discord.com/developers/applications)
DISCORD_TOKEN=seu_token_aqui

# Token da API do Genius para letras (obtenha em https://genius.com/developers)
GENIUS_API_KEY=seu_token_genius

# Caminho para arquivo cookies.txt do YouTube (formato Netscape)
# Necessário em VPS/datacenter para evitar bloqueio "Sign in to confirm you're not a bot"
# Exporte com a extensão "Get cookies.txt LOCALLY" no Chrome/Firefox
YT_COOKIES_PATH=/data/cookies.txt
